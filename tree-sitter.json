{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "avenger",
      "camelcase": "Avenger",
      "title": "Avenger",
      "scope": "source.avenger",
      "path": ".",
      "file-types": ["avenger"],
      "highlights": ["queries/highlights.scm"],
      "brackets": ["queries/brackets.scm"],
      "indents": ["queries/indents.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Avenger visualization language",
    "authors": [
      { "name": "Jon Mease" },
      { "name": "Avenger contributors" },
      { "name": "Derek Stride" }
    ],
    "links": {
      "repository": "https://github.com/avenger-vis/tree-sitter-avenger"
    }
  },
  "bindings": {
    "c": true,
    "rust": true
  }
}
