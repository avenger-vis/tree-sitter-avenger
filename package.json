{
  "name": "@avenger-vis/tree-sitter-avenger",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Avenger visualization language",
  "type": "module",
  "main": "grammar.js",
  "exports": {
    ".": "./grammar.js"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:highlights": "node scripts/test_highlights.mjs",
    "test:fixtures": "node scripts/test_compiler_fixtures.mjs",
    "test:fixtures:wasm": "node scripts/test_compiler_fixtures.mjs --wasm",
    "check-generated": "sh scripts/check_generated.sh",
    "check-generated:json": "sh scripts/check_generated.sh --from-json",
    "build:wasm": "node scripts/build_wasm.mjs",
    "test:wasm": "tree-sitter test --wasm",
    "test:fuzz": "tree-sitter fuzz --iterations 100 --edits 8",
    "test:scanner-sanitizers": "sh scripts/test_scanner_sanitizers.sh",
    "measure": "node scripts/measure_parser.mjs",
    "sync:sql-base": "node scripts/sync_sql_base.mjs",
    "sync:fixtures": "node scripts/sync_avenger_fixtures.mjs"
  },
  "license": "MIT",
  "author": "Jon Mease and Avenger contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avenger-vis/tree-sitter-avenger.git"
  },
  "keywords": [
    "avenger",
    "parser",
    "visualization",
    "tree-sitter"
  ],
  "files": [
    "bindings/c/**",
    "bindings/rust/**",
    "docs/**",
    "grammar.js",
    "grammar/**",
    "LICENSE",
    "queries/**",
    "README.md",
    "SQL_BASE.md",
    "src/**",
    "tree-sitter.json",
    "vendor/avenger_sql_scanner.c",
    "vendor/sql-base.json"
  ],
  "dependencies": {
    "@avenger-vis/tree-sitter-avenger-sql": "https://github.com/avenger-vis/tree-sitter-avenger-sql/archive/005679d80e91578ccbaf5ede87a2cd854f8abc8b.tar.gz"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.3"
  }
}
