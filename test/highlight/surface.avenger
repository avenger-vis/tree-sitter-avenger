-- | A chart-level documentation comment.
avenger 1;
import { catalog as data } from './catalog.avenger' sha256 'abc123';
import * as acme from 'native:acme';

export chart custom as demo {
  public param float64 as width { value: 640; }
  param store as rows { field utf8 id; }
  param selection as picked {}
  mark group as panel {}
  variable row sample {}
  equality { id { field: "id"; value: 1; } }
  projected: plot($width);
  expressions: sum("value") AS Total;
  mark acme.custom_mark as points {
    x: coalesce($width@start, 0);
  }
  on pointermove as hover {
    set cursor = 'crosshair';
  }
}

define mark badge {
  slot number radius;
  slot channel x;
  output span(0, $radius) as bounds;
  export points as marks;
}

define transform summarize {
  slot outputs measures;
  transform aggregate { expressions: measures; }
}
