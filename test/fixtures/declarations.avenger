avenger 1;

chart custom as demo {
  private param as threshold { type: float64; default: 1; }
  public store as rows { field id: int64; }
  selection as brush { type: interval; }
  resource tiles as osm {}
  theme css from './theme.css' sha256 'abc123';
  theme css: 'mark { color: red; }';
  group as panel {}
  mark symbol as points {}
  transform filter as visible {}
  tool pan_zoom as pan {}
  tool stateless;
  widget slider as size {}
  view raster as image {}
  on pointermove as hover {
    target: marks [panel.points,];
    scope: subplot grid.left;
    surface: legend color;
    set param threshold at current replacing scopes = 2;
    set store rows at start = replace { source: $rows; }
    set selection brush = $brush;
    set cursor = 'crosshair';
  }
  cell cartesian as left at { row: 0; column: 0; } {}
  plot cartesian {}
  variable row as mpg {}
  part title {}
  level 2 {}
  adjust {}
  adjust dodge as shifted {}
  derive aggregate as totals {}
  overlay as annotation {}
  layer foreground {}
  when {}
  field amount: decimal128(38, -2) nullable;
  row {}
  key {}
  fields {}
  scale_edit {}
  scale_hint {}
  dimension as frame {}
  clause {}
  equality {}
  interval {}
  output count: coalesce($threshold, 0);
  export panel.points as exported_points;
}

define mark badge {
  slot expr as x;
  slot expr_list as values {}
  slot literal as fill;
  slot number as radius;
  slot string as label;
  slot boolean as enabled;
  slot enum as style { values: [dot, line]; }
  slot function as formatter { class: scalar; }
  slot ref as target { kind: mark; }
  slot block as content;
  channel x;
  channel y: y2;
  output bounds: span(0, $radius);
  export implementation.points as marks;
  private group as implementation {
    match style {
      dot { mark symbol {} }
      line { mark line {} }
    }
    content;
  }
}
