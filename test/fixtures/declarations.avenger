avenger 1;

chart custom as demo {
  private param float64 as threshold { value: 1; }
  public param store as rows { field int64 id; }
  param selection as brush {}
  resource tiles as osm {}
  theme css from './theme.css' sha256 'abc123';
  theme css: 'mark { color: red; }';
  mark group as panel {}
  mark symbol as points {}
  transform filter as visible {}
  tool pan_zoom as pan {}
  tool stateless;
  widget slider as size {}
  view raster as image {}
  on pointermove as hover {
    target: marks [panel.points,];
    scope: subplot grid.left;
    surface: legend color;
    set threshold at current replacing scopes = 2;
    set rows at start = replace_rows { source: $rows; }
    set brush = clear;
    set cursor = 'crosshair';
  }
  cell cartesian as left at { row: 0; column: 0; } {}
  plot cartesian {}
  variable row mpg {}
  part title {}
  level 2 {}
  adjust expr {}
  adjust dodge as shifted {}
  derive aggregate as totals {}
  overlay: { mark group as annotation {} }
  layer foreground {}
  when {}
  field decimal128(38, -2) amount nullable;
  row {}
  key {}
  fields {}
  scale_edit {}
  scale_hint {}
  clause {}
  equality { category { field: "category"; value: datum('category'); } }
  interval { x { field: "x"; from: 0; to: 1; } }
  output coalesce($threshold, 0) as count;
  export panel.points as exported_points;
}

define mark badge {
  slot expr x;
  slot expr_list values {}
  slot literal fill;
  slot number radius;
  slot string label;
  slot boolean enabled;
  slot enum style { values: [dot, line]; }
  slot function formatter { class: scalar; }
  slot ref target { kind: mark; }
  slot block content;
  slot channel x;
  slot channel y { default: y2; }
  output span(0, $radius) as bounds;
  export implementation.points as marks;
  private mark group as implementation {
    match style {
      dot { mark symbol {} }
      line { mark line {} }
    }
    content;
  }
}
